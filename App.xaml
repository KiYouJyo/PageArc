<Application
    x:Class="PageArc.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageArcCanvasBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="PageArcPaneBrush" Color="#F9F9F9"/>
                    <SolidColorBrush x:Key="PageArcCardBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="PageArcToolbarBrush" Color="#F9F9F9"/>
                    <SolidColorBrush x:Key="PageArcSurfaceBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="PageArcCardStrokeBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="PageArcAccentBrush" Color="#005FB8"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageArcCanvasBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="PageArcPaneBrush" Color="#272727"/>
                    <SolidColorBrush x:Key="PageArcCardBrush" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="PageArcToolbarBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="PageArcSurfaceBrush" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="PageArcCardStrokeBrush" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="PageArcAccentBrush" Color="#60CDFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PageArcCanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcPaneBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcCardBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="PageArcToolbarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="PageArcAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageArcCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PageArcCardBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource PageArcCardStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
