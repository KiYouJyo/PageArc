<Application
    x:Class="PageArc.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Match UrbanPlanToolbox: a cyan navigation pane over the system Mica surface. -->
                    <SolidColorBrush x:Key="PageArcNavigationPaneBrush" Color="#E5F9F9"/>
                    <SolidColorBrush x:Key="PageArcCanvasBrush" Color="#00FFFFFF"/>
                    <SolidColorBrush x:Key="PageArcPaneBrush" Color="#E5F9F9"/>
                    <SolidColorBrush x:Key="PageArcToolbarBrush" Color="#00FFFFFF"/>
                    <StaticResource x:Key="PageArcCardBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
                    <StaticResource x:Key="PageArcSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
                    <StaticResource x:Key="PageArcCardStrokeBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
                    <StaticResource x:Key="PageArcAccentBrush" ResourceKey="AccentFillColorDefaultBrush"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- Exact shell pane tint used by UrbanPlanToolbox. The content remains Mica-backed. -->
                    <SolidColorBrush x:Key="PageArcNavigationPaneBrush" Color="#1A2323"/>
                    <SolidColorBrush x:Key="PageArcCanvasBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="PageArcPaneBrush" Color="#1A2323"/>
                    <SolidColorBrush x:Key="PageArcToolbarBrush" Color="#00000000"/>
                    <StaticResource x:Key="PageArcCardBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
                    <StaticResource x:Key="PageArcSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
                    <StaticResource x:Key="PageArcCardStrokeBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
                    <StaticResource x:Key="PageArcAccentBrush" ResourceKey="AccentFillColorDefaultBrush"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PageArcNavigationPaneBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcCanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcPaneBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcToolbarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcCardBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="PageArcSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="PageArcAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageArcCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PageArcCardBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource PageArcCardStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
