<Application
    x:Class="PageArc.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="PageArcCanvasBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F8FCFB" Offset="0"/>
                        <GradientStop Color="#EEF8F7" Offset="0.48"/>
                        <GradientStop Color="#E5F2F3" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PageArcPaneBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F5FBFA" Offset="0"/>
                        <GradientStop Color="#EAF5F4" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PageArcToolbarBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F8FCFB" Offset="0"/>
                        <GradientStop Color="#EDF7F6" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PageArcCardBrush" Color="#E8FFFFFF"/>
                    <SolidColorBrush x:Key="PageArcSurfaceBrush" Color="#ECFFFFFF"/>
                    <SolidColorBrush x:Key="PageArcCardStrokeBrush" Color="#180B3438"/>
                    <SolidColorBrush x:Key="PageArcAccentBrush" Color="#006C78"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="PageArcCanvasBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#102A2E" Offset="0"/>
                        <GradientStop Color="#0B2024" Offset="0.5"/>
                        <GradientStop Color="#07171A" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PageArcPaneBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#142F32" Offset="0"/>
                        <GradientStop Color="#0B2023" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PageArcToolbarBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#112B2F" Offset="0"/>
                        <GradientStop Color="#091C20" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PageArcCardBrush" Color="#D91A3033"/>
                    <SolidColorBrush x:Key="PageArcSurfaceBrush" Color="#E61A3033"/>
                    <SolidColorBrush x:Key="PageArcCardStrokeBrush" Color="#2A8FB8BC"/>
                    <SolidColorBrush x:Key="PageArcAccentBrush" Color="#6EDBE5"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PageArcCanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcPaneBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcCardBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="PageArcToolbarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PageArcCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="PageArcAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageArcCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PageArcCardBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource PageArcCardStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
