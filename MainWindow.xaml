<Window
    x:Class="PageArc.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" Background="Transparent" Loaded="OnWindowRootLoaded">
    <Grid x:Name="MainContent" Opacity="0" IsHitTestVisible="False">
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="MainWindow_SessionRestoreLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="Transparent"
              ColumnDefinitions="104,*,132"
              Padding="16,0,12,0"
              Loaded="AppTitleBar_TabChromeLoaded">
            <TextBlock Text="PageArc"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"/>

            <!-- Keep PageArc's detached tabs, but align their shell geometry with
                 the approved SpatialViewer title bar. -->
            <ScrollViewer Grid.Column="1"
                          Height="32"
                          Margin="0,8,12,8"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          IsTabStop="False">
                <StackPanel x:Name="ShellTabs" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <!-- Compatibility contract: IsAddTabButtonVisible="True" is represented by the explicit SpatialViewer-shaped ShellNewTabButton. -->
                    <StackPanel x:Name="ShellTabItems" Orientation="Horizontal" Spacing="8"/>
                    <Button x:Name="ShellNewTabButton"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="7"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="ShellNewTabButton_Click">
                        <TextBlock Text="+" FontSize="17" Opacity="0.68"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="WorkspaceHost" Grid.Row="1">
            <!-- Match SpatialViewer exactly: title bar and navigation pane share the same
                 window Mica layer. NavigationView.Auto owns compact/expanded transitions;
                 application resize code must never force IsPaneOpen or PaneDisplayMode. -->
            <NavigationView
                x:Name="AppNavigation"
                Background="Transparent"
                IsSettingsVisible="False"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="True"
                PaneDisplayMode="Auto"
                OpenPaneLength="252"
                CompactPaneLength="64"
                Loaded="AppNavigation_Loaded"
                SelectionChanged="AppNavigation_SelectionChanged">
                <NavigationView.Resources>
                    <!-- Keep WinUI's content surface native and only make the pane chrome transparent,
                         following SpatialViewer's shell contract. This prevents an extra tint over
                         the hamburger region and keeps live Light/Dark switching correct. -->
                    <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewPaneContentGridMargin">0</Thickness>
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
                    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="PageArcNavigationPaneBrush"/>
                    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="PageArcNavigationPaneBrush"/>
                    <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="PageArcNavigationPaneBrush"/>
                </NavigationView.Resources>
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Uid="Nav_Library" Tag="library">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_Categories" Tag="categories">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Folder"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_Conversion" Tag="conversion">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Switch"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Uid="Nav_ImportFolders" Tag="import-folders">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="SyncFolder"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_Settings" Tag="settings">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_About" Tag="about">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Help"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame"/>
            </NavigationView>
            <Grid x:Name="ReaderHost" Visibility="Collapsed"/>
        </Grid>
    </Grid>
    </Grid>
    <Grid x:Name="StartupOverlay" Background="Transparent" Canvas.ZIndex="100">
        <Image x:Name="StartupLogo"
               Source="ms-appx:///Assets/Icon-Large-1024.png"
               Width="183"
               Height="183"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               ImageOpened="OnStartupLogoImageOpened"
               ImageFailed="OnStartupLogoImageFailed"/>
    </Grid>
    </Grid>
</Window>
