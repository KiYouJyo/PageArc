<Window
    x:Class="PageArc.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="MainWindow_SessionRestoreLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="162"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PageArc" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>

            <!-- Figma 44:2 / 43:* — compact detached title-bar tabs aligned with the PageArc wordmark. -->
            <ScrollViewer Grid.Column="1"
                          Height="32"
                          Margin="0,8,12,8"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          IsTabStop="False">
                <StackPanel x:Name="ShellTabs" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <!-- Compatibility contract: IsAddTabButtonVisible="True" is represented by the explicit Figma-shaped ShellNewTabButton. -->
                    <StackPanel x:Name="ShellTabItems" Orientation="Horizontal" Spacing="8"/>
                    <Button x:Name="ShellNewTabButton"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="7"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="ShellNewTabButton_Click">
                        <TextBlock Text="+" FontSize="17" Opacity="0.68"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="WorkspaceHost" Grid.Row="1">
            <NavigationView
                x:Name="AppNavigation"
                Background="Transparent"
                IsSettingsVisible="False"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="True"
                PaneDisplayMode="Auto"
                OpenPaneLength="240"
                CompactPaneLength="64"
                Loaded="AppNavigation_Loaded"
                DisplayModeChanged="AppNavigation_DisplayModeChanged"
                SelectionChanged="AppNavigation_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Uid="Nav_Library" Tag="library">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_Categories" Tag="categories">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Folder"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_Conversion" Tag="conversion">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Switch"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Uid="Nav_ImportFolders" Tag="import-folders">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="SyncFolder"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_Settings" Tag="settings">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_About" Tag="about">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Help"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame"/>
            </NavigationView>
            <Grid x:Name="ReaderHost" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
