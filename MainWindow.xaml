<Window
    x:Class="PageArc.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource PageArcCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource PageArcToolbarBrush}">
            <TextBlock Text="PageArc" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="1">
            <NavigationView
                x:Name="AppNavigation"
                Background="{ThemeResource PageArcCanvasBrush}"
                IsSettingsVisible="False"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="True"
                IsPaneOpen="True"
                PaneDisplayMode="Left"
                OpenPaneLength="240"
                CompactPaneLength="64"
                SelectionChanged="AppNavigation_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Uid="Nav_Library" Tag="library">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_Recent" Tag="recent">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Clock"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_Favorites" Tag="favorites">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Favorite"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_Collections" Tag="collections">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Folder"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Uid="Nav_ImportFolders" Tag="import-folders">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Import"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_Settings" Tag="settings">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Nav_About" Tag="about">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Help"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame"/>
            </NavigationView>

            <Frame x:Name="ReaderFrame" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
