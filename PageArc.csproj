<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PageArc</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == ''">win-x64;win-arm64</RuntimeIdentifiers>
    <UseRidGraph>true</UseRidGraph>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <ApplicationDisplayVersion>1.1.1</ApplicationDisplayVersion>
    <ApplicationVersion>18</ApplicationVersion>
    <PageArcDistributionChannel Condition="'$(PageArcDistributionChannel)' == ''">GitHub</PageArcDistributionChannel>
    <DefineConstants Condition="'$(PageArcDistributionChannel)' == 'Store'">$(DefineConstants);PAGEARC_STORE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft Store packages use the Store-assigned identity and publisher.
         GitHub/side-load builds intentionally continue to use Package.appxmanifest. -->
    <AppxManifest Include="Package.Store.appxmanifest" Condition="'$(PageArcDistributionChannel)' == 'Store'">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Branding masters are kept in source control for future asset generation but
         are not referenced by the running app or either manifest. -->
    <Content Remove="Assets\AppLogo.png;Assets\AppLogoSource.png;Assets\AppLogoSourceClean.png" />
    <None Include="Assets\AppLogo.png;Assets\AppLogoSource.png;Assets\AppLogoSourceClean.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows App SDK/MSIX currently embeds XBF resources using their filename only.
         Flatten the logical Link for XAML Pages kept in subdirectories so generated
         LoadComponent URIs match the PRI/XBF resource index. All Page XAML filenames
         in this executable project must therefore remain unique. -->
    <Page Update="Pages\*.xaml">
      <Link>%(Filename)%(Extension)</Link>
    </Page>
    <Page Update="App.xaml">
      <Link>App.xaml</Link>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Content Include="ThirdParty\foliate-js\mobi.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\foliate-js\pagearc-host.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\foliate-js\vendor\fflate.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\foliate-js\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\foliate-js\PIN.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\fflate\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\calibre\PIN.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\calibre\runtime\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('ThirdParty\calibre\runtime')" />
    <Content Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7463" />
  </ItemGroup>
</Project>
