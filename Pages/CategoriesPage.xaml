<Page
    x:Class="PageArc.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PageArc.Models"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="132"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock x:Uid="Categories_Title" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Uid="Categories_Subtitle" Margin="0,4,0,0" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Top">
                <AutoSuggestBox x:Name="SearchBox" x:Uid="Library_Search" Width="320" TextChanged="SearchBox_TextChanged">
                    <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find"/></AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
                <Button x:Uid="Categories_New" Click="NewCategory_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add"/><TextBlock x:Uid="Categories_NewText"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Viewbox Width="42" Height="42" HorizontalAlignment="Center"><SymbolIcon Symbol="Folder"/></Viewbox>
                <TextBlock x:Uid="Categories_EmptyTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Uid="Categories_EmptyBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                <Button x:Uid="Categories_EmptyNew" HorizontalAlignment="Center" Click="NewCategory_Click"/>
            </StackPanel>

            <ScrollViewer x:Name="CategoriesScrollViewer" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ItemsRepeater x:Name="CategoriesRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="258" MinItemHeight="206" MinColumnSpacing="26" MinRowSpacing="24" MaximumRowsOrColumns="4" ItemsStretch="Fill" ItemsJustification="Start" Orientation="Horizontal"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryEntry">
                            <Button Tag="{x:Bind Name}" MinWidth="258" Height="206" Click="CategoryCard_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Style="{StaticResource PageArcCardStyle}" Padding="15" Height="206" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="120"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{ThemeResource PageArcAccentBrush}" CornerRadius="6">
                                            <TextBlock Text="{x:Bind Monogram}" Margin="18,16,0,0" FontSize="28" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Top"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{x:Bind Name}" Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind BookCount}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Uid="Categories_BooksSuffix" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
