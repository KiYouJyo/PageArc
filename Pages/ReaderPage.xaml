<Page
    x:Class="PageArc.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PageArc.Models"
    Background="{ThemeResource PageArcReaderAreaBrush}"
    Loaded="ReaderPage_FigmaLoaded">

    <Page.Resources>
        <Style x:Key="ReaderToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ReaderSidebarTabButtonStyle" TargetType="Button" BasedOn="{StaticResource ReaderToolButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ReaderNavButtonStyle" TargetType="Button" BasedOn="{StaticResource ReaderToolButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="{ThemeResource PageArcReaderToolbarBrush}"/>
        </Style>
        <Style x:Key="ReaderSegmentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{ThemeResource PageArcCardStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ReaderThemeCardStyle" TargetType="Button">
            <Setter Property="Height" Value="64"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="{ThemeResource PageArcCardStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ReaderTocItemStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="12,0,8,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters><Setter Target="SelectionLayer.Opacity" Value="0.55"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters><Setter Target="SelectionLayer.Opacity" Value="0.78"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters><Setter Target="SelectionLayer.Opacity" Value="1"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <VisualState.Setters><Setter Target="SelectionLayer.Opacity" Value="1"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPressed">
                                        <VisualState.Setters><Setter Target="SelectionLayer.Opacity" Value="1"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ItemSurface.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="SelectionLayer"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    Opacity="0"/>
                            <Border x:Name="ItemSurface"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="Transparent">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="ReaderRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Figma 16:156 / 16:227: sidebar toggle + title + generic More + settings at far right. -->
        <Grid Grid.Row="0"
              Height="48"
              Background="{ThemeResource PageArcReaderToolbarBrush}"
              BorderBrush="{ThemeResource PageArcCardStrokeBrush}"
              BorderThickness="0,0,0,1">
            <Button x:Name="SidebarToggleButton"
                    Style="{StaticResource ReaderToolButtonStyle}"
                    Width="40"
                    Margin="12,8,0,8"
                    HorizontalAlignment="Left"
                    Click="SidebarToggle_Click">
                <FontIcon Glyph="&#xE700;" FontSize="16"/>
            </Button>

            <TextBlock x:Name="BookTitleText"
                       Margin="64,0,126,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>

            <StackPanel Width="86"
                        Height="32"
                        Margin="0,8,24,8"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Right">
                <Button x:Name="MoreButton"
                        x:Uid="Reader_More"
                        Style="{StaticResource ReaderToolButtonStyle}"
                        Width="40"
                        Padding="0">
                    <TextBlock Text="•••" FontSize="13"/>
                </Button>
                <Button x:Name="AppearanceButton"
                        x:Uid="Reader_Appearance"
                        Style="{StaticResource ReaderToolButtonStyle}"
                        Width="40"
                        Click="AppearanceButton_Click">
                    <TextBlock Text="Aa" FontSize="13" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ContentsColumn" Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SettingsColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ContentsPane"
                    Grid.Column="0"
                    Background="{ThemeResource PageArcReaderPaneBrush}"
                    BorderBrush="{ThemeResource PageArcReaderDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                                <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Figma refined 236×36 mode strip: roomier labels and hit targets. -->
                    <Grid Margin="12,12,12,0" Height="36" VerticalAlignment="Top" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ContentsModeButton" Tag="contents" Style="{StaticResource ReaderSidebarTabButtonStyle}" Click="SidebarModeButton_Click"><TextBlock x:Name="ContentsModeLabel" CharacterSpacing="40"/></Button>
                        <Button x:Name="SearchModeButton" Grid.Column="1" Tag="search" Style="{StaticResource ReaderSidebarTabButtonStyle}" Click="SidebarModeButton_Click"><TextBlock x:Name="SearchModeLabel" CharacterSpacing="40"/></Button>
                        <Button x:Name="BookmarksModeButton" Grid.Column="2" Tag="bookmarks" Style="{StaticResource ReaderSidebarTabButtonStyle}" Click="SidebarModeButton_Click"><TextBlock x:Name="BookmarksModeLabel" CharacterSpacing="40"/></Button>
                        <Button x:Name="NotesModeButton" Grid.Column="3" Tag="notes" Style="{StaticResource ReaderSidebarTabButtonStyle}" Click="SidebarModeButton_Click"><TextBlock x:Name="NotesModeLabel" CharacterSpacing="40"/></Button>
                    </Grid>

                    <Grid x:Name="ContentsMode" Grid.Row="1" Padding="16,12,16,16">
                        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                        <StackPanel Margin="4,0,0,0"><TextBlock x:Uid="Reader_ContentsHeading" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ContentsMetaText" Margin="0,6,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                        <ListView x:Name="TocList" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ReaderTocItemStyle}" SelectionChanged="TocList_SelectionChanged">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition IsStaggeringEnabled="True"/>
                                    <RepositionThemeTransition/>
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                        </ListView>
                        <TextBlock x:Name="BookProgressText" Grid.Row="2" Margin="4,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom"/>
                    </Grid>

                    <Grid x:Name="SearchMode" Grid.Row="1" Padding="16,12,16,16" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="42"/><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                        <TextBlock x:Name="SearchHeading" Margin="4,0,0,0" FontSize="20" FontWeight="SemiBold"/>
                        <AutoSuggestBox x:Name="ReaderSearchBox" Grid.Row="1" Height="34" VerticalAlignment="Top" TextChanged="SearchBox_TextChanged"><AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find"/></AutoSuggestBox.QueryIcon></AutoSuggestBox>
                        <TextBlock x:Name="SearchCountText" Grid.Row="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <ListView x:Name="SearchResultsList" Grid.Row="3" SelectionMode="Single" SelectionChanged="SearchResultsList_SelectionChanged"><ListView.ItemTemplate><DataTemplate x:DataType="models:ReaderSearchListItem"><Grid MinHeight="76" Padding="8,7"><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ChapterTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{x:Bind PositionText}" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Snippet}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                        <TextBlock x:Name="SearchFooterText" Grid.Row="4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom"/>
                    </Grid>

                    <Grid x:Name="BookmarksMode" Grid.Row="1" Padding="16,12,16,16" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                        <StackPanel Margin="4,0,0,0"><TextBlock x:Name="BookmarksHeading" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="BookmarksMetaText" Margin="0,6,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                        <Button x:Name="AddCurrentBookmarkButton" Grid.Row="1" Height="32" HorizontalAlignment="Stretch" Click="AddCurrentBookmark_Click"/>
                        <ListView x:Name="BookmarksList" Grid.Row="2" SelectionMode="Single" SelectionChanged="BookmarksList_SelectionChanged"><ListView.ItemTemplate><DataTemplate x:DataType="models:ReaderBookmarkListItem"><Grid MinHeight="80" Padding="8,7"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ChapterTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{x:Bind PercentText}" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Snippet}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                        <TextBlock x:Name="BookmarksFooterText" Grid.Row="3" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <Grid x:Name="NotesMode" Grid.Row="1" Padding="16,12,16,16" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                        <StackPanel Margin="4,0,0,0"><TextBlock x:Name="NotesHeading" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="NotesMetaText" Margin="0,6,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                        <ListView x:Name="NotesList" Grid.Row="1" SelectionMode="Single" SelectionChanged="NotesList_SelectionChanged"><ListView.ItemTemplate><DataTemplate x:DataType="models:ReaderAnnotationListItem"><Border MinHeight="102" Margin="0,0,0,10" Padding="9" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource PageArcCardStrokeBrush}" BorderThickness="1" CornerRadius="6"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="4" Background="{x:Bind AccentBrush}" CornerRadius="2"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{x:Bind ChapterTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Quote}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Note}" Visibility="{x:Bind NoteVisibility}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                        <TextBlock x:Name="NotesFooterText" Grid.Row="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="ReadingArea" Grid.Column="1" Background="{ThemeResource PageArcReaderAreaBrush}" SizeChanged="ReaderReadingArea_SizeChanged">
                <!-- The WebView always keeps the same 1600 x 900 logical canvas. The outer
                     viewport changes its real layout extent for pane/window/zoom changes, so
                     scaling cannot paint into an adjacent pane and never repaginates the book. -->
                <ScrollViewer x:Name="ReaderFrameViewport"
                              Margin="24,20,24,68"
                              HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto"
                              ZoomMode="Disabled"
                              HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Top">
                    <Grid x:Name="ReaderFrameCanvas" Width="1600" Height="900">
                        <Viewbox x:Name="ReaderFrameViewbox"
                                 Width="1600"
                                 Height="900"
                                 Stretch="Uniform"
                                 StretchDirection="Both"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Border x:Name="ReaderSurface"
                                    Width="1600"
                                    Height="900"
                                    Background="{ThemeResource PageArcReaderPageBrush}"
                                    BorderBrush="{ThemeResource PageArcCardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid><WebView2 x:Name="ReaderWebView"/><Grid x:Name="ReaderLoadingLayer" Background="{ThemeResource PageArcReaderPageBrush}" Visibility="Collapsed"><ProgressRing Width="36" Height="36" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Grid>
                            </Border>
                        </Viewbox>
                    </Grid>
                </ScrollViewer>

                <Button x:Name="PreviousPageButton" Style="{StaticResource ReaderNavButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,338,0,0" Click="Previous_Click"><Button.RenderTransform><TranslateTransform X="-426"/></Button.RenderTransform><TextBlock Text="‹" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Button>
                <Button x:Name="NextPageButton" Style="{StaticResource ReaderNavButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,338,0,0" Click="Next_Click"><Button.RenderTransform><TranslateTransform X="426"/></Button.RenderTransform><TextBlock Text="›" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Button>

                <!-- Explicit columns keep chapter, slider, page jump, total and percent from ever overlapping. -->
                <Grid x:Name="ReaderProgressStrip" Height="44" Margin="24,0,24,12" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ChapterProgressText" Grid.Column="0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Slider x:Name="ReaderProgress" Grid.Column="2" Height="30" Padding="10,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Minimum="0" Maximum="1" StepFrequency="0.001" ValueChanged="ReaderProgress_ValueChanged"/>
                    <TextBlock x:Name="PageJumpLabel" Grid.Column="4" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="PageJumpBox" Grid.Column="5" Width="48" Height="28" MinWidth="0" Padding="4,0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" TextAlignment="Center" KeyDown="PageJumpBox_KeyDown" LostFocus="PageJumpBox_LostFocus"/>
                    <TextBlock x:Name="PageTotalText" Grid.Column="6" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ReaderPercentText" Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <InfoBar x:Name="ReaderInfoBar" IsOpen="False" VerticalAlignment="Top" Margin="12"/>
            </Grid>

            <!-- Figma 16:227 refined: settings is a full-height right pane, not a floating flyout. -->
            <Border x:Name="ReaderSettingsPane"
                    Grid.Column="2"
                    Width="260"
                    Visibility="Collapsed"
                    Background="{ThemeResource PageArcReaderPaneBrush}"
                    BorderBrush="{ThemeResource PageArcReaderDividerBrush}"
                    BorderThickness="1,0,0,0">
                <Grid Padding="16,14,16,14">
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Uid="ReaderSettings_Title" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="ReaderSettingsCloseButton" Style="{StaticResource ReaderToolButtonStyle}" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ReaderSettingsClose_Click"><TextBlock Text="×" FontSize="16"/></Button>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="ReaderSettings_ThemeLabel" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="ThemeLightButton" Tag="light" Style="{StaticResource ReaderThemeCardStyle}" Background="White" Click="ReaderThemeCard_Click"><StackPanel Spacing="2"><TextBlock Text="Aa" FontSize="16" FontWeight="SemiBold" Foreground="#FF1F1F1F"/><TextBlock x:Name="ThemeLightText" FontSize="11" Foreground="#D11F1F1F"/></StackPanel></Button>
                                <Button x:Name="ThemeSepiaButton" Grid.Column="1" Tag="sepia" Style="{StaticResource ReaderThemeCardStyle}" Background="#FFF2E8D1" Click="ReaderThemeCard_Click"><StackPanel Spacing="2"><TextBlock Text="Aa" FontSize="16" FontWeight="SemiBold" Foreground="#FF473829"/><TextBlock x:Name="ThemeSepiaText" FontSize="11" Foreground="#D1473829"/></StackPanel></Button>
                                <Button x:Name="ThemeDarkButton" Grid.Column="2" Tag="dark" Style="{StaticResource ReaderThemeCardStyle}" Background="#FF1F1F1F" Click="ReaderThemeCard_Click"><StackPanel Spacing="2"><TextBlock Text="Aa" FontSize="16" FontWeight="SemiBold" Foreground="#FFF0F0F0"/><TextBlock x:Name="ThemeDarkText" FontSize="11" Foreground="#D1F0F0F0"/></StackPanel></Button>
                            </Grid>

                            <TextBlock x:Name="ReaderFontLabel" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="FigmaFontFamilyCombo" Height="34" HorizontalAlignment="Stretch" SelectionChanged="FigmaFontFamily_SelectionChanged"><ComboBoxItem x:Uid="Font_BookDefault" Tag="book"/><ComboBoxItem Content="Segoe UI Variable" Tag="Segoe UI Variable"/><ComboBoxItem Content="Georgia" Tag="Georgia"/></ComboBox>

                            <TextBlock x:Uid="ReaderSettings_FontSizeLabel" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Text="A−" FontSize="12" VerticalAlignment="Center"/><Slider x:Name="ReaderFontScaleSlider" Grid.Column="1" Minimum="0.8" Maximum="1.6" StepFrequency="0.1" ValueChanged="ReaderFontScaleSlider_ValueChanged"/><TextBlock Grid.Column="2" Text="A+" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>

                            <TextBlock x:Uid="ReaderSettings_LineSpacingLabel" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnSpacing="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="LineCompactButton" Tag="1.5" Style="{StaticResource ReaderSegmentButtonStyle}" Click="ReaderLineSpacing_Click"><TextBlock x:Name="LineCompactText"/></Button><Button x:Name="LineNormalButton" Grid.Column="1" Tag="1.75" Style="{StaticResource ReaderSegmentButtonStyle}" Click="ReaderLineSpacing_Click"><TextBlock x:Name="LineNormalText"/></Button><Button x:Name="LineRelaxedButton" Grid.Column="2" Tag="2.0" Style="{StaticResource ReaderSegmentButtonStyle}" Click="ReaderLineSpacing_Click"><TextBlock x:Name="LineRelaxedText"/></Button></Grid>

                            <TextBlock x:Name="ReaderViewOptionsLabel" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="SinglePageButton" Grid.ColumnSpan="2" Tag="spread:single" Style="{StaticResource ReaderSegmentButtonStyle}" Click="ReaderViewOption_Click"><TextBlock x:Name="SinglePageText" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                                <Button x:Name="OddPageStartButton" Grid.Row="1" Tag="spread:odd" Style="{StaticResource ReaderSegmentButtonStyle}" Click="ReaderViewOption_Click"><TextBlock x:Name="OddPageStartText" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                                <Button x:Name="EvenPageStartButton" Grid.Row="1" Grid.Column="1" Tag="spread:even" Style="{StaticResource ReaderSegmentButtonStyle}" Click="ReaderViewOption_Click"><TextBlock x:Name="EvenPageStartText" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                                <Button x:Name="FitPageWidthButton" Grid.Row="2" Tag="zoom:fit-width" Style="{StaticResource ReaderSegmentButtonStyle}" Click="ReaderViewOption_Click"><TextBlock x:Name="FitPageWidthText" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                                <Button x:Name="FitPageHeightButton" Grid.Row="2" Grid.Column="1" Tag="zoom:fit-height" Style="{StaticResource ReaderSegmentButtonStyle}" Click="ReaderViewOption_Click"><TextBlock x:Name="FitPageHeightText" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                            </Grid>
                            <ToggleSwitch x:Name="ClickPageTurnToggle"
                                          Margin="0,4,0,0"
                                          HorizontalAlignment="Stretch"
                                          IsOn="True"
                                          Toggled="ClickPageTurnToggle_Toggled"/>
                            <Border Height="1" Margin="0,4,0,0" Background="{ThemeResource PageArcCardStrokeBrush}"/>
                            <HyperlinkButton x:Name="FigmaResetReaderButton" Padding="0,5" HorizontalAlignment="Left" Click="FigmaReaderReset_Click"/>
                            <ComboBox x:Name="ReaderThemeCombo" Visibility="Collapsed" SelectionChanged="ReaderThemeCombo_SelectionChanged"><ComboBoxItem x:Uid="ReadingTheme_Light" Tag="light"/><ComboBoxItem x:Uid="ReadingTheme_Sepia" Tag="sepia"/><ComboBoxItem x:Uid="ReadingTheme_Dark" Tag="dark"/></ComboBox>
                            <Slider x:Name="ReaderLineHeightSlider" Visibility="Collapsed" Minimum="1.35" Maximum="2.1" StepFrequency="0.05" ValueChanged="ReaderLineHeightSlider_ValueChanged"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Selection notes autosave and close when focus moves elsewhere. -->
        <Popup x:Name="SelectionAnnotationPopup" IsLightDismissEnabled="True">
            <Border x:Name="SelectionAnnotationCard"
                    Width="360"
                    Height="74"
                    Padding="10"
                    Background="{ThemeResource PageArcReaderFlyoutBrush}"
                    BorderBrush="{ThemeResource PageArcCardStrokeBrush}"
