<Page
    x:Class="PageArc.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PageArc.Models"
    Background="{ThemeResource PageArcCanvasBrush}"
    Loaded="ReaderPage_NotesLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{ThemeResource PageArcToolbarBrush}"
              BorderBrush="{ThemeResource PageArcCardStrokeBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,8"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Uid="Reader_Back" Click="Back_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Back"/>
                    <TextBlock x:Uid="Reader_BackText"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="BookTitleText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <Button x:Name="ContentsButton" x:Uid="Reader_Contents" Click="Contents_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Bullets"/>
                        <TextBlock x:Uid="Reader_ContentsText"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SearchButton" x:Uid="Reader_Search" Click="Search_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Find"/>
                        <TextBlock x:Uid="Reader_SearchText"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AppearanceButton" x:Uid="Reader_Appearance">
                    <TextBlock Text="Aa" FontWeight="SemiBold"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="300" Spacing="12">
                                <TextBlock x:Uid="ReaderSettings_Title" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Uid="ReaderSettings_ThemeLabel" FontWeight="SemiBold"/>
                                <ComboBox x:Name="ReaderThemeCombo" SelectionChanged="ReaderThemeCombo_SelectionChanged">
                                    <ComboBoxItem x:Uid="ReadingTheme_Light" Tag="light"/>
                                    <ComboBoxItem x:Uid="ReadingTheme_Sepia" Tag="sepia"/>
                                    <ComboBoxItem x:Uid="ReadingTheme_Dark" Tag="dark"/>
                                </ComboBox>
                                <TextBlock x:Uid="ReaderSettings_FontSizeLabel" FontWeight="SemiBold"/>
                                <Slider x:Name="ReaderFontScaleSlider" Minimum="0.8" Maximum="1.6" StepFrequency="0.1" ValueChanged="ReaderFontScaleSlider_ValueChanged"/>
                                <TextBlock x:Uid="ReaderSettings_LineSpacingLabel" FontWeight="SemiBold"/>
                                <Slider x:Name="ReaderLineHeightSlider" Minimum="1.35" Maximum="2.1" StepFrequency="0.05" ValueChanged="ReaderLineHeightSlider_ValueChanged"/>
                                <ToggleSwitch x:Name="ContinuousScrollToggle" x:Uid="ReaderSettings_Continuous" Toggled="ReaderSettings_Continuous_Toggled"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="BookmarkButton" x:Uid="Reader_Bookmark" Click="Bookmark_Click"><SymbolIcon Symbol="Bookmarks"/></Button>
                <Button x:Name="MoreButton" x:Uid="Reader_More" Click="Notes_Click"><SymbolIcon Symbol="More"/></Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ContentsColumn" Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ContentsPane"
                    Grid.Column="0"
                    Background="{ThemeResource PageArcPaneBrush}"
                    BorderBrush="{ThemeResource PageArcCardStrokeBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid x:Name="ContentsMode" Padding="16,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Reader_ContentsHeading" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ContentsMetaText" Margin="0,6,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ListView x:Name="TocList" Grid.Row="1" SelectionChanged="TocList_SelectionChanged"/>
                        <TextBlock x:Name="BookProgressText" Grid.Row="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <Grid x:Name="SearchMode" Padding="16,20" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="Reader_SearchText" FontSize="20" FontWeight="SemiBold"/>
                        <AutoSuggestBox x:Name="ReaderSearchBox"
                                        Grid.Row="1"
                                        Height="34"
                                        VerticalAlignment="Top"
                                        TextChanged="SearchBox_TextChanged">
                            <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find"/></AutoSuggestBox.QueryIcon>
                        </AutoSuggestBox>
                        <TextBlock x:Name="SearchCountText" Grid.Row="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <ListView x:Name="SearchResultsList" Grid.Row="3" SelectionMode="Single" SelectionChanged="SearchResultsList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ReaderSearchListItem">
                                    <Grid MinHeight="76" Padding="8,7">
                                        <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ChapterTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind PositionText}" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Snippet}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="SearchFooterText" Grid.Row="4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom"/>
                    </Grid>

                    <Grid x:Name="BookmarksMode" Padding="16,20" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="BookmarksHeading" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BookmarksMetaText" Margin="0,6,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ListView x:Name="BookmarksList" Grid.Row="1" SelectionMode="Single" SelectionChanged="BookmarksList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ReaderBookmarkListItem">
                                    <Grid MinHeight="80" Padding="8,7">
                                        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ChapterTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind PercentText}" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Snippet}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="BookmarksFooterText" Grid.Row="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <Grid x:Name="NotesMode" Padding="16,20" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="NotesHeading" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="NotesMetaText" Margin="0,6,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ListView x:Name="NotesList" Grid.Row="1" SelectionMode="Single" SelectionChanged="NotesList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ReaderAnnotationListItem">
                                    <Border MinHeight="102"
                                            Margin="0,0,0,10"
                                            Padding="9"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource PageArcCardStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" Background="{x:Bind AccentBrush}" CornerRadius="2"/>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <TextBlock Text="{x:Bind ChapterTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Quote}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind NoteVisibility}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NotesFooterText" Grid.Row="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Padding="28,24,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Previous_Click">
                    <SymbolIcon Symbol="Previous"/>
                </Button>

                <Border x:Name="ReaderSurface"
                        Grid.Column="1"
                        Background="{ThemeResource PageArcSurfaceBrush}"
                        BorderBrush="{ThemeResource PageArcCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        MaxWidth="760">
                    <Grid>
                        <WebView2 x:Name="ReaderWebView"/>
                        <Grid x:Name="ReaderLoadingLayer" Background="{ThemeResource PageArcSurfaceBrush}" Visibility="Collapsed">
                            <ProgressRing Width="36" Height="36" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <Button Grid.Column="2" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Next_Click">
                    <SymbolIcon Symbol="Next"/>
                </Button>

                <Grid Grid.Row="1" Grid.Column="1" MaxWidth="760">
                    <TextBlock x:Name="ChapterProgressText" FontSize="12" VerticalAlignment="Top"/>
                    <ProgressBar x:Name="ReaderProgress" Height="3" Margin="60,4,40,0" VerticalAlignment="Top" Minimum="0" Maximum="1"/>
                    <TextBlock x:Name="ReaderPercentText" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Top"/>
                </Grid>
                <InfoBar x:Name="ReaderInfoBar" Grid.RowSpan="2" Grid.ColumnSpan="3" IsOpen="False" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
