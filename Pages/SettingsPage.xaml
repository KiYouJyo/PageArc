<Page
    x:Class="PageArc.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="SettingsLayout" Padding="28,24,28,36" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Uid="Settings_Title" FontSize="34" FontWeight="SemiBold"/>
                <TextBlock x:Uid="Settings_Subtitle" Margin="0,4,0,0" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource PageArcSectionStyle}">
                <StackPanel Spacing="14">
                    <StackPanel><TextBlock x:Uid="Settings_Appearance" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="AppearanceSectionHint" Margin="0,3,0,0" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <Border Style="{StaticResource PageArcInsetStyle}">
                        <Grid Padding="18,0">
                            <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="1"/><RowDefinition Height="68"/><RowDefinition Height="1"/><RowDefinition Height="68"/><RowDefinition Height="1"/><RowDefinition Height="68"/></Grid.RowDefinitions>
                            <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Uid="Settings_AppTheme"/><TextBlock x:Uid="Settings_AppThemeHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ComboBox x:Name="ThemeCombo" Grid.Column="1" Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged"><ComboBoxItem x:Uid="Theme_System" Tag="system"/><ComboBoxItem x:Uid="Theme_Light" Tag="light"/><ComboBoxItem x:Uid="Theme_Dark" Tag="dark"/></ComboBox></Grid>
                            <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource PageArcDividerBrush}"/>
                            <Grid Grid.Row="2" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="AccentLabel"/><TextBlock x:Name="AccentHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ComboBox x:Name="AccentCombo" Grid.Column="1" Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Center"><ComboBoxItem x:Name="WindowsAccentItem" Tag="windows"/></ComboBox></Grid>
                            <Rectangle Grid.Row="3" Height="1" Fill="{ThemeResource PageArcDividerBrush}"/>
                            <Grid Grid.Row="4" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Uid="Settings_Language"/><TextBlock x:Uid="Settings_LanguageHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ComboBox x:Name="LanguageCombo" Grid.Column="1" Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="LanguageCombo_SelectionChanged"><ComboBoxItem x:Uid="Language_System" Tag="system"/><ComboBoxItem Content="中文（简体）" Tag="zh-CN"/><ComboBoxItem Content="日本語" Tag="ja-JP"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox></Grid>
                            <Rectangle Grid.Row="5" Height="1" Fill="{ThemeResource PageArcDividerBrush}"/>
                            <Grid Grid.Row="6" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Uid="Settings_ReadingTheme"/><TextBlock x:Uid="Settings_ReadingThemeHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ComboBox x:Name="ReadingThemeCombo" Grid.Column="1" Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Center"><ComboBoxItem x:Uid="ReadingTheme_App" Tag="app"/><ComboBoxItem x:Uid="ReadingTheme_Light" Tag="light"/><ComboBoxItem x:Uid="ReadingTheme_Sepia" Tag="sepia"/><ComboBoxItem x:Uid="ReadingTheme_Dark" Tag="dark"/></ComboBox></Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <Grid x:Name="MiddleCards" Grid.Row="4" ColumnSpacing="18" RowSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="*"/><ColumnDefinition x:Name="ReadingColumn" Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="LibraryCard" Style="{StaticResource PageArcSectionStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel><TextBlock x:Uid="Settings_Library" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="LibrarySectionHint" Margin="0,3,0,0" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                        <Border Style="{StaticResource PageArcInsetStyle}"><Grid Padding="18,0"><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="1"/><RowDefinition Height="62"/><RowDefinition Height="1"/><RowDefinition Height="62"/><RowDefinition Height="1"/><RowDefinition Height="62"/></Grid.RowDefinitions>
                            <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock x:Name="LibrarySortLabel" VerticalAlignment="Center"/><ComboBox x:Name="LibrarySortCombo" Grid.Column="1" Width="150" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center"><ComboBoxItem x:Name="LibrarySortRecentItem" Tag="recent"/><ComboBoxItem x:Name="LibrarySortTitleItem" Tag="title"/></ComboBox></Grid><Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource PageArcDividerBrush}"/>
                            <Grid Grid.Row="2" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Uid="Settings_ShowRecent"/><TextBlock x:Uid="Settings_ShowRecentHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch x:Name="RecentToggle" Grid.Column="1" Width="40" MinWidth="0" Padding="0" OnContent="" OffContent="" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Rectangle Grid.Row="3" Height="1" Fill="{ThemeResource PageArcDividerBrush}"/>
                            <Grid Grid.Row="4" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Uid="Settings_ImportFolders"/><TextBlock x:Uid="Settings_ImportFoldersHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Button Grid.Column="1" x:Uid="Settings_ManageFolders" MinWidth="92" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ManageFolders_Click"/></Grid><Rectangle Grid.Row="5" Height="1" Fill="{ThemeResource PageArcDividerBrush}"/>
                            <Grid Grid.Row="6" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Uid="Settings_Duplicates"/><TextBlock x:Uid="Settings_DuplicatesHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch x:Name="DuplicatesToggle" Grid.Column="1" Width="40" MinWidth="0" Padding="0" OnContent="" OffContent="" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        </Grid></Border>
                    </StackPanel>
                </Border>
                <Border x:Name="ReadingCard" Grid.Column="1" Style="{StaticResource PageArcSectionStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel><TextBlock x:Uid="Settings_Reading" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ReadingSectionHint" Margin="0,3,0,0" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                        <Border Style="{StaticResource PageArcInsetStyle}"><Grid Padding="18,0"><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="1"/><RowDefinition Height="62"/><RowDefinition Height="1"/><RowDefinition Height="62"/></Grid.RowDefinitions>
                            <Grid><TextBlock x:Uid="Settings_Font" VerticalAlignment="Center"/><ComboBox x:Name="FontCombo" Width="190" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center"><ComboBoxItem x:Uid="Font_BookDefault" Tag="book"/><ComboBoxItem Content="Segoe UI Variable" Tag="Segoe UI Variable"/><ComboBoxItem Content="Georgia" Tag="Georgia"/></ComboBox></Grid><Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource PageArcDividerBrush}"/>
                            <Grid Grid.Row="2"><TextBlock x:Uid="Settings_FontSize" VerticalAlignment="Center"/><Slider x:Name="FontScaleSlider" Width="190" Minimum="0.8" Maximum="1.6" StepFrequency="0.1" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Rectangle Grid.Row="3" Height="1" Fill="{ThemeResource PageArcDividerBrush}"/>
                            <Grid Grid.Row="4"><TextBlock x:Uid="Settings_LineSpacing" VerticalAlignment="Center"/><Slider x:Name="LineHeightSlider" Width="190" Minimum="1.35" Maximum="2.1" StepFrequency="0.05" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                        </Grid></Border>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Exact structural port from UrbanPlanToolbox Views/SettingsPage.xaml
                 DataManagementCard @ 249bbf99088e5edc92b9a6f9b7635ca777cf847e.
                 Only labels and handlers are PageArc-specific. -->
            <Border x:Name="DataManagementCard" Grid.Row="6" Style="{StaticResource SettingsSectionCardStyle}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DataManagementTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock x:Name="DataManagementDescription" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid x:Name="DataManagementGrid" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="DataLocalPanel"
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="1"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                VerticalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="LocalBackupTitle" Style="{StaticResource SettingsRowLabelStyle}"/>
                                    <TextBlock x:Name="LocalBackupDescription" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="LocalBackupStatusLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                    <TextBlock x:Name="LocalBackupStatus" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid x:Name="DataActions" HorizontalAlignment="Left" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ExportButton" Grid.Column="0" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="BackupReadingData_Click"/>
                                    <Button x:Name="ImportButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="RestoreReadingData_Click"/>
                                    <Button x:Name="ClearDataButton" Grid.Column="2" HorizontalAlignment="Left" Click="ClearCache_Click"/>
                                </Grid>
                                <InfoBar x:Name="DataStatusBar" IsOpen="False"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DataCloudPanel"
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.ColumnSpan="1"
                                Margin="0"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                VerticalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="WebDavTitle" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="WebDavDescription" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="WebDavStatusLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                    <TextBlock x:Name="WebDavStatusValue" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="WebDavBackupButton" Grid.Column="0" Style="{StaticResource AccentButtonStyle}" Click="SyncWebDav_Click"/>
                                    <Button x:Name="WebDavRestoreButton" Grid.Column="1" Click="RestoreWebDav_Click"/>
                                    <Button x:Name="WebDavManageButton" Grid.Column="2" Click="ManageWebDav_Click"/>
                                    <Button x:Name="WebDavConfigureButton" Grid.Column="3" Click="ConfigureWebDav_Click"/>
                                </Grid>
                                <InfoBar x:Name="WebDavStatusBar" IsOpen="False"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowSettings">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ReadingColumn.Width" Value="0"/>
                            <Setter Target="ReadingCard.(Grid.Column)" Value="0"/>
                            <Setter Target="ReadingCard.(Grid.Row)" Value="1"/>
                            <Setter Target="SettingsLayout.Padding" Value="20,22,20,36"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="DesktopSettings">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050"/></VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="DataManagementResponsiveStates">
                    <VisualState x:Name="DataManagementCompact">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DataLocalPanel.(Grid.ColumnSpan)" Value="2"/>
                            <Setter Target="DataCloudPanel.(Grid.Row)" Value="1"/>
                            <Setter Target="DataCloudPanel.(Grid.Column)" Value="0"/>
                            <Setter Target="DataCloudPanel.(Grid.ColumnSpan)" Value="2"/>
                            <Setter Target="DataCloudPanel.Margin" Value="0,12,0,0"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="DataManagementWide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="520"/></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DataLocalPanel.(Grid.ColumnSpan)" Value="1"/>
                            <Setter Target="DataCloudPanel.(Grid.Row)" Value="0"/>
                            <Setter Target="DataCloudPanel.(Grid.Column)" Value="1"/>
                            <Setter Target="DataCloudPanel.(Grid.ColumnSpan)" Value="1"/>
                            <Setter Target="DataCloudPanel.Margin" Value="0"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ScrollViewer>
</Page>
