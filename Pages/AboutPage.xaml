<Page
    x:Class="PageArc.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageArcCanvasBrush}">
    <Grid Padding="24">
        <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="250"/><RowDefinition Height="24"/><RowDefinition Height="276"/><RowDefinition Height="20"/><RowDefinition Height="120"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Uid="About_Title" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Uid="About_Subtitle" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PageArcCardStyle}" CornerRadius="10">
            <Grid ColumnSpacing="32"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="112" Height="112" Background="#1A005FB8" CornerRadius="24" VerticalAlignment="Center"><TextBlock Text="PA" FontSize="36" FontWeight="SemiBold" Foreground="{ThemeResource PageArcAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8"><TextBlock Text="PageArc" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="AboutVersionText" x:Uid="About_Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Uid="About_Description" FontSize="15"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3" ColumnSpacing="24" RowSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="128"/></Grid.RowDefinitions>
            <Border Style="{StaticResource PageArcCardStyle}"><StackPanel Spacing="10"><TextBlock x:Uid="About_Formats" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="EPUB · MOBI · AZW3 · FB2 · LIT" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource PageArcCardStyle}"><StackPanel Spacing="10"><TextBlock x:Uid="About_Storage" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Uid="About_StorageBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
            <Border Grid.Row="1" Style="{StaticResource PageArcCardStyle}"><StackPanel Spacing="10"><TextBlock x:Uid="About_Privacy" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Uid="About_PrivacyBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PageArcCardStyle}"><StackPanel Spacing="10"><TextBlock x:Uid="About_Licenses" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Uid="About_LicensesBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="5" Style="{StaticResource PageArcCardStyle}"><Grid>
            <StackPanel VerticalAlignment="Center" Spacing="8"><TextBlock x:Uid="About_Updates" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatusText" x:Uid="About_UpdatesBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            <Button x:Name="CheckUpdatesButton" x:Uid="About_CheckUpdates" Width="160" HorizontalAlignment="Right" Click="CheckUpdates_Click"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh"/><TextBlock x:Uid="About_CheckUpdatesText"/></StackPanel></Button>
        </Grid></Border>
        <InfoBar x:Name="UpdateInfoBar" IsOpen="False" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
    </Grid>
</Page>