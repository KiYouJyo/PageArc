<Page
    x:Class="PageArc.Pages.ImportFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageArcCanvasBrush}">
    <Grid Padding="24">
        <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock x:Uid="Folders_Title" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Uid="Folders_Subtitle" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            <Button x:Uid="Folders_Add" HorizontalAlignment="Right" VerticalAlignment="Top" Click="AddFolder_Click"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add"/><TextBlock x:Uid="Folders_AddText"/></StackPanel></Button>
        </Grid>
        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" x:Uid="Folders_Info"/>
        <StackPanel Grid.Row="2" x:Name="FoldersList" Spacing="12"><Border Style="{StaticResource PageArcCardStyle}"><StackPanel><TextBlock x:Uid="Folders_EmptyTitle" FontWeight="SemiBold"/><TextBlock x:Uid="Folders_EmptyBody" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border></StackPanel>
    </Grid>
</Page>
