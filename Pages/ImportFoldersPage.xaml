<Page
    x:Class="PageArc.Pages.ImportFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageArcCanvasBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="104"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock x:Name="PageTitleText" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageSubtitleText" Margin="0,4,0,0" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="TopAddFolderButton" Width="118" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Click="AddFolder_Click">
                <TextBlock x:Name="TopAddFolderText" FontSize="13" FontWeight="SemiBold"/>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="#0D005FB8" CornerRadius="8" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="16" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock x:Name="InfoBannerText" Grid.Column="1" Margin="8,0,0,0" FontSize="13" Opacity="0.68" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsRepeater x:Name="FoldersRepeater">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Height="118" Margin="0,0,0,12" Style="{StaticResource PageArcCardStyle}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="206"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE8B7;" FontSize="22" Opacity="0.62" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"/>

                                    <StackPanel Grid.Column="1" Margin="0,0,20,0" Spacing="5">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.53" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="5">
                                        <TextBlock Text="{Binding CountText}" FontSize="13" Opacity="0.66"/>
                                        <TextBlock Text="{Binding ScanText}" FontSize="12" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Button Width="86" Height="32" Tag="{Binding Id}" Click="RescanFolder_Click">
                                            <TextBlock Text="{Binding RescanText}" FontSize="13"/>
                                        </Button>
                                        <Button Width="94" Height="32" Tag="{Binding Id}" Click="RemoveFolder_Click">
                                            <TextBlock Text="{Binding RemoveText}" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Border x:Name="EmptyFoldersCard" Height="118" Style="{StaticResource PageArcCardStyle}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                        <TextBlock x:Name="EmptyFoldersTitle" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyFoldersBody" FontSize="12" Opacity="0.55" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Height="92" Margin="0,12,0,0" Background="#05000000" BorderBrush="{ThemeResource PageArcCardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <StackPanel VerticalAlignment="Center" Spacing="5">
                    <TextBlock x:Name="AddAnotherTitle" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AddAnotherBody" FontSize="12" Opacity="0.52"/>
                </StackPanel>
                <Button Width="118" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddFolder_Click">
                    <TextBlock x:Name="BottomAddFolderText" FontSize="13"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
