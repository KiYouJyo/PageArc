<Page
    x:Class="PageArc.Pages.ConversionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PageArc.Models"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="132"/>
            <RowDefinition Height="410"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="174"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Uid="Conversion_Title" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock x:Uid="Conversion_Subtitle" Margin="0,4,0,0" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PageArcCardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="230"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Uid="Conversion_SourceTitle" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Uid="Conversion_SourceSubtitle" Margin="0,5,0,0" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Border x:Name="DropZone" Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource PageArcCardStrokeBrush}" Background="{ThemeResource PageArcPaneBrush}" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="⇧" FontSize="34" Foreground="{ThemeResource PageArcAccentBrush}"/>
                            <TextBlock x:Uid="Conversion_DropTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Uid="Conversion_DropSubtitle" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            <Button x:Uid="Conversion_ChooseFiles" Click="ChooseFiles_Click" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Add"/><TextBlock x:Uid="Conversion_ChooseFilesText"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0" Spacing="8">
                        <TextBlock x:Uid="Conversion_FormatsHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Uid="Conversion_DrmHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PageArcCardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="54"/><RowDefinition Height="34"/><RowDefinition Height="120"/><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Uid="Conversion_SettingsTitle" FontSize="18" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1">
                        <TextBlock x:Uid="Conversion_OutputFormat" VerticalAlignment="Center"/>
                        <ComboBox x:Name="OutputFormatCombo" Width="260" HorizontalAlignment="Right" SelectedIndex="0">
                            <ComboBoxItem Content="EPUB"/><ComboBoxItem Content="FB2"/><ComboBoxItem Content="MOBI"/><ComboBoxItem Content="AZW3"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock Grid.Row="2" x:Uid="Conversion_ContentOptions" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="3" Spacing="8">
                        <CheckBox x:Name="MetadataCheck" x:Uid="Conversion_KeepMetadata" IsChecked="True"/>
                        <CheckBox x:Name="CoverCheck" x:Uid="Conversion_KeepCover" IsChecked="True"/>
                        <CheckBox x:Name="TocCheck" x:Uid="Conversion_KeepToc" IsChecked="True"/>
                    </StackPanel>
                    <Border Grid.Row="4" Background="{ThemeResource PageArcPaneBrush}" CornerRadius="6" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="i" Foreground="{ThemeResource PageArcAccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Uid="Conversion_SafetyNotice" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartConversionButton" Grid.Row="5" x:Uid="Conversion_Start" Click="StartConversion_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="⇄"/><TextBlock x:Uid="Conversion_StartText"/></StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource PageArcCardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Uid="Conversion_QueueTitle" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="QueueCountText" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <StackPanel x:Name="EmptyQueue" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <FontIcon Glyph="⇄" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Uid="Conversion_QueueEmpty" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ListView x:Name="QueueList" Grid.Row="1" Visibility="Collapsed" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ConversionQueueItem">
                            <Grid Padding="4,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Format}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Status}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <InfoBar x:Name="ConversionInfoBar" Grid.RowSpan="5" IsOpen="False" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
    </Grid>
</Page>
